<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sentinel</groupId>
    <artifactId>sentinel-remediation-agent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Sentinel Remediation Agent</name>
    <description>
        Autonomous vulnerability scan -> triage -> remediation pipeline.
        Scanner MCP server (Trivy) + Remediation MCP server (GitHub PR / email fallback)
        orchestrated by a Gemini-powered agent, queued through RabbitMQ.
    </description>

    <modules>
        <module>common</module>
        <module>scanner-mcp</module>
        <module>remediation-mcp</module>
        <module>api-gateway</module>
        <module>orchestrator-worker</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- NOTE: Spring AI's MCP module surface has moved fast (see README "Version Notes").
             Pin these explicitly and re-check docs.spring.io before a real build. -->
        <spring-boot.version>3.5.11</spring-boot.version>
        <spring-ai.version>1.1.4</spring-ai.version>
        <!-- spring-ai-bom does not manage the raw MCP Java SDK artifacts directly; import its
             own BOM too. If you hit a NoSuchMethodError/ClassNotFoundException at runtime
             between MCP classes, this is the version to bump check
             https://mvnrepository.com/artifact/io.modelcontextprotocol.sdk/mcp-bom for one
             that lines up with whatever spring-ai.version you're on. -->
        <mcp-sdk.version>0.17.0</mcp-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- internal shared module -->
            <dependency>
                <groupId>com.sentinel</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

